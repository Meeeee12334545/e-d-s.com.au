# Copy to .env (which git ignores) and fill in. On a host, set these in its
# environment settings instead.

# Turns on the analytics dashboard at /admin. Use a long password only you know.
ADMIN_PASSWORD=

# Optional
# PORT=4173
# DATA_DIR=data                     # where analytics.db is kept; needs a persistent disk on a host
# ANALYTICS_TZ=Australia/Brisbane   # time zone for days and hours in the dashboard
# SESSION_SECRET=                   # signs the admin cookie; defaults to one derived from ADMIN_PASSWORD
# ANALYTICS_LOOKUP=off               # skip the organisation and city lookup (and the monthly city database download)
# PAGES_URL=https://www.e-d-s.com.au # only when the pages are hosted elsewhere: page requests redirect there
