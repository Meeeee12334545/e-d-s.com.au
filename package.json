{
  "name": "eds-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Environmental Data Services (EDS) website, with a small server for visit analytics",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node build.mjs && npm start"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "lucide-static": "^1.49.0"
  },
  "dependencies": {
    "mmdb-lib": "^3.0.3"
  }
}
